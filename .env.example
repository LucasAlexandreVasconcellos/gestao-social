# Configurações do Banco de Dados PostgreSQL Oficial
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestao-social
DB_USERNAME=gestao_app
DB_PASSWORD=
DB_SCHEMA=gestao_social

# Ambiente e Segurança da Aplicação
APP_ENV=production
APP_DEMO_MODE=false
APP_PUBLIC_URL=http://localhost:8000
APP_SIGNING_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_64_HEX
SESSION_IDLE_TIMEOUT=1800

# Identidade Institucional do Órgão (exibida no cabeçalho, login e PDFs)
APP_ORG_NAME="Secretaria Municipal de Assistência Social"
APP_UNIT_NAME="Gestão Socioassistencial — SUAS"

# Integração de Mensageria (Opcional: driver webhook)
NOTIF_WEBHOOK_URL=
NOTIF_WEBHOOK_TOKEN=
