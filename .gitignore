# Sessões e Logs
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/documentos/*
!/storage/documentos/.gitkeep
!/storage/documentos/.htaccess

# Arquivos de Ambiente e Credenciais
.env
.env.local
.env.*.local

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos temporários e de teste
*.tmp
*.log
